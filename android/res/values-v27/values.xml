<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Dark buttons on the light bar at the bottom; phones before Android 8.1 cannot do this -->
    <style name="Paper" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/paper</item>
        <item name="android:statusBarColor">@color/paper</item>
        <item name="android:navigationBarColor">@color/paper</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
    </style>
</resources>
